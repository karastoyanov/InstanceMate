# Single env file for the whole project (backend, frontend, mcp-server,
# infra) - copy this to .env in the repo root and fill in what you need.
# Never commit .env or real credentials/instance data.

# --- Database ---
# Individual settings, also consumed directly by infra/docker-compose.yml
# for the local Postgres container - change these, not DATABASE_URL below.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=instancemate

# Built from the values above (python-dotenv expands ${VAR} references) -
# edit those, not this line. Leave commented out to fall back to a local
# SQLite file instead, so the backend runs with zero setup.
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Sessions / auth ---
SESSION_SECRET=changeme

# --- App URLs (used to build the OAuth redirect_uri and for CORS) ---
# Use the same hostname here as VITE_API_BASE_URL/FRONTEND_URL below
# (localhost, not 127.0.0.1) so the session cookie is same-site.
APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# --- Session lifetime (seconds) ---
# How long a logged-in session stays valid, and how long an in-progress
# OAuth login attempt stays valid before it must be restarted.
SESSION_LIFETIME_SECONDS=43200
PENDING_AUTHORIZATION_LIFETIME_SECONDS=600

# --- Embeddings ---
EMBEDDING_MODEL=local-embedding-model-name

# --- LLM providers (BYOK) ---
# Not set here - each user adds their own provider + API key via the
# Settings page in the app, stored encrypted per-user in the database.

# --- Frontend (Vite) ---
# Where the frontend reaches the backend. Keep this hostname consistent
# with APP_BASE_URL above (localhost, not 127.0.0.1).
VITE_API_BASE_URL=http://localhost:5000

# --- MCP server ---
# Where the backend reaches the MCP server (once #22 wires that up), and
# the host/port the MCP server itself binds to.
MCP_SERVER_URL=http://localhost:8001
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
# Placeholder only, for manually exercising a future tool against a single
# fixed instance - real per-user ServiceNow auth is handled by the backend
# (see mcp-server/app/config.py).
SERVICENOW_INSTANCE_URL=
SERVICENOW_ACCESS_TOKEN=
